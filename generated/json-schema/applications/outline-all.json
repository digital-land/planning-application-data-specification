  "definitions": {
    "other-contact": {
      "type": "object",
      "properties": {
        "fullname": {
          "type": "string"
        },
        "number": {
          "type": "string"
        },
        "email": {
          "type": "string"
        }
      },
      "required": [
        "fullname",
        "number",
        "email"
      ]
    },
    "bng-details": {
      "type": "object",
      "properties": {
        "pre-development-date": {
          "type": "string"
        },
        "pre-development-biodiversity-value": {
          "type": "number"
        },
        "earlier-date-reason": {
          "type": "string"
        },
        "habitat-loss-after-2020": {
          "type": "boolean"
        },
        "habitat-loss-details": {
          "$ref": "#/definitions/habitat-loss-details"
        },
        "metric-publication-date": {
          "type": "string"
        },
        "irreplaceable-habitats": {
          "type": "boolean"
        },
        "irreplaceable-habitats-details": {
          "type": "string"
        },
        "supporting-documents": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/supporting-document"
          },
          "minItems": 1
        }
      },
      "required": [
        "pre-development-date",
        "pre-development-biodiversity-value",
        "earlier-date-reason",
        "metric-publication-date",
        "irreplaceable-habitats",
        "supporting-documents"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "habitat-loss-after-2020": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "habitat-loss-details"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "irreplaceable-habitats": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "irreplaceable-habitats-details"
            ]
          }
        }
      ]
    },
    "waste-streams": {
      "type": "object",
      "properties": {
        "municipal": {
          "type": "number"
        },
        "construction-demolition": {
          "type": "number"
        },
        "commercial-industrial": {
          "type": "number"
        },
        "hazardous": {
          "type": "number"
        }
      },
      "required": []
    },
    "site-location": {
      "type": "object",
      "properties": {
        "geometry": {
