          "type": "string",
          "enum": [
            "primary",
            "secondary"
          ]
        }
      },
      "required": []
    },
    "floorspace-details-outline": {
      "type": "object",
      "properties": {
        "use": {
          "type": "string",
          "enum": [
            "b2",
            "b8",
            "c1",
            "c2",
            "c2a",
            "c3",
            "c4",
            "e-a",
            "e-b",
            "e-c-i",
            "e-c-ii",
            "e-c-iii",
            "e-d",
            "e-e",
            "e-f",
            "e-g-i",
            "e-g-ii",
            "e-g-iii",
            "f1-a",
            "f1-b",
            "f1-c",
            "f1-d",
            "f1-e",
            "f1-f",
            "f1-g",
            "f2-a",
            "f2-b",
            "f2-c",
            "f2-d",
            "sui",
            "other"
          ]
        },
        "specified-use": {
          "type": "string"
        },
        "existing-gross-floorspace": {
          "type": "number"
        },
        "is-floorspace-lost-known": {
          "type": "boolean"
        },
        "floorspace-lost": {
          "type": "number"
        },
        "is-total-gross-proposed-known": {
          "type": "boolean"
        },
        "total-gross-proposed": {
          "type": "number"
        },
        "net-additional-floorspace": {
          "type": "number"
        }
      },
      "required": [
        "use",
        "existing-gross-floorspace",
        "net-additional-floorspace"
      ],
      "allOf": [
        {
          "if": {
            "anyOf": [
              {
                "properties": {
                  "use": {
                    "pattern": "sui"
                  }
                }
              },
              {
                "properties": {
                  "use": {
                    "pattern": "other"
                  }
                }
              }
            ]
          },
          "then": {
            "required": [
              "specified-use"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "is-floorspace-lost-known": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "floorspace-lost"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "is-total-gross-proposed-known": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "total-gross-proposed"
            ]
          }
        }
      ]
    },
    "person": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "first-name": {
          "type": "string"
        },
        "last-name": {
          "type": "string"
        },
        "contact-address": {
          "$ref": "#/definitions/contact-address"
        }
      },
      "required": [
        "first-name",
        "last-name",
        "contact-address"
      ]
    },
    "contact-address": {
      "type": "object",
      "properties": {
        "address-text": {
          "type": "string"
        },
        "postcode": {
          "type": "string"
        },
        "uprn": {
          "type": "string"
        }
      },
      "required": [
