    "bng-exemption-reason": {
      "type": "object",
      "properties": {
        "exemption-type": {
          "type": "string",
          "enum": [
            "pre-commencement",
            "small-sites",
            "de-minimis",
            "self-build",
            "gain-site",
            "retrospective",
            "hs2"
          ]
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "exemption-type",
        "reason"
      ]
    },
    "unit-quantities": {
      "type": "object",
      "properties": {
        "units-unknown": {
          "type": "boolean"
        },
        "units-per-bedroom-no": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/bedroom-count"
          },
          "minItems": 1
        },
        "total-units": {
          "type": "integer"
        }
      },
      "required": [
        "units-unknown"
      ],
      "if": {
        "anyOf": [
          {
            "properties": {
              "units-unknown": {
                "const": false
              }
            }
          }
        ]
      },
      "then": {
        "required": [
          "units-per-bedroom-no"
        ]
      }
    },
    "bedroom-count": {
      "type": "object",
      "properties": {
        "no-bedrooms-unknown": {
          "type": "boolean"
        },
        "no-of-bedrooms": {
          "type": "integer"
        },
        "units": {
          "type": "integer"
        }
      },
      "required": [
        "no-bedrooms-unknown",
        "units"
