        "annual-throughput",
        "unit-type"
      ]
    },
    "supporting-document": {
      "type": "object",
      "properties": {
        "reference": {
          "type": "string"
        }
      },
      "required": [
        "reference"
      ]
    },
    "hours-of-operation": {
      "type": "object",
      "properties": {
        "use": {
          "type": "string",
          "enum": [
            "b2",
            "b8",
            "c1",
            "c2",
            "c2a",
            "c3",
            "c4",
            "e-a",
            "e-b",
            "e-c-i",
            "e-c-ii",
            "e-c-iii",
            "e-d",
            "e-e",
            "e-f",
            "e-g-i",
            "e-g-ii",
            "e-g-iii",
            "f1-a",
            "f1-b",
            "f1-c",
            "f1-d",
            "f1-e",
            "f1-f",
            "f1-g",
            "f2-a",
            "f2-b",
            "f2-c",
            "f2-d",
            "sui",
            "other"
          ]
        },
        "use-other": {
          "type": "string"
        },
        "operational-times": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/operational-times"
          },
          "minItems": 1
        },
        "hours-not-known": {
          "type": "boolean"
        }
      },
      "required": [
        "use",
        "hours-not-known"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "use": {
                "const": "other"
              }
            }
          },
          "then": {
            "required": [
              "use-other"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "hours-not-known": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "operational-times"
            ]
          }
        }
      ]
    },
    "room-details-outline": {
      "type": "object",
      "properties": {
        "use-class-accommodation": {
          "type": "string",
          "enum": [
            "c1",
            "c2",
            "c2a",
            "other"
          ]
        },
        "use-other": {
          "type": "string"
        },
        "is-existing-rooms-lost-known": {
          "type": "boolean"
        },
        "existing-rooms-lost": {
          "type": "integer"
        },
        "is-total-rooms-proposed-known": {
          "type": "boolean"
        },
        "total-rooms-proposed": {
          "type": "integer"
        },
        "net-additional-rooms": {
          "type": "integer"
        }
      },
      "required": [
        "use-class-accommodation",
        "net-additional-rooms"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "use-class-accommodation": {
                "const": "other"
              }
            }
          },
          "then": {
            "required": [
              "use-other"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "is-existing-rooms-lost-known": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "existing-rooms-lost"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "is-total-rooms-proposed-known": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "total-rooms-proposed"
            ]
          }
        }
      ]
    },
    "operational-times": {
      "type": "object",
      "properties": {
        "schedule-days": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "monday",
              "tuesday",
              "wednesday",
              "thursday",
              "friday",
              "saturday",
              "sunday",
              "bank-holiday"
            ]
          },
          "minItems": 1
        },
        "closed": {
          "type": "boolean"
        },
        "time-ranges": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/time-range"
          },
          "minItems": 1
        }
      },
      "required": [
        "schedule-days"
      ],
      "if": {
        "properties": {
          "closed": {
            "const": false
          }
        }
      },
      "then": {
        "required": [
          "time-ranges"
        ]
      }
    },
    "employees": {
      "type": "object",
      "properties": {
        "full-time": {
          "type": "integer"
        },
        "part-time": {
          "type": "integer"
        },
        "total-fte": {
          "type": "number"
        }
      },
      "required": [
        "full-time",
        "part-time",
        "total-fte"
      ]
    },
    "existing-use-detail": {
      "type": "object",
      "properties": {
        "use": {
          "type": "string",
          "enum": [
            "b2",
            "b8",
            "c1",
            "c2",
            "c2a",
            "c3",
            "c4",
            "e-a",
            "e-b",
            "e-c-i",
            "e-c-ii",
            "e-c-iii",
            "e-d",
            "e-e",
            "e-f",
            "e-g-i",
            "e-g-ii",
            "e-g-iii",
            "f1-a",
            "f1-b",
            "f1-c",
            "f1-d",
            "f1-e",
            "f1-f",
            "f1-g",
            "f2-a",
            "f2-b",
            "f2-c",
            "f2-d",
            "sui",
            "other"
          ]
        },
        "use-details": {
          "type": "string"
        },
        "land-part": {
          "type": "string"
        }
      },
      "required": [
        "use",
        "land-part"
      ],
      "if": {
        "allOf": [
          {
            "properties": {
              "use": {
                "const": "sui"
              }
            }
          },
          {
            "properties": {
              "use": {
                "const": "other"
              }
            }
          }
        ]
      },
      "then": {
        "required": [
          "use-details"
        ]
      }
    },
    "notified-person": {
      "type": "object",
      "properties": {
        "person": {
          "$ref": "#/definitions/person"
        },
        "notice-served-date": {
          "type": "string"
        }
      },
      "required": []
    },
    "newspaper-notice": {
      "type": "object",
      "properties": {
        "newspaper-name": {
          "type": "string"
        },
        "publication-date": {
          "type": "string"
        }
      },
      "required": [
        "newspaper-name",
        "publication-date"
      ]
    },
    "site-address": {
      "type": "object",
      "properties": {
        "address-text": {
          "type": "string"
        },
        "postcode": {
          "type": "string"
        },
        "uprns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "usrns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      },
      "required": [
        "address-text"
      ]
    },
    "habitat-loss-details": {
      "type": "object",
      "properties": {
        "loss-date": {
          "type": "string"
        },
        "pre-loss-biodiversity-value": {
          "type": "number"
        },
        "supporting-evidence": {
          "type": "string"
        }
      },
      "required": [
        "loss-date",
        "pre-loss-biodiversity-value"
      ]
    },
    "residential-unit-summary": {
      "type": "object",
      "properties": {
        "tenure-type": {
          "type": "string",
