        "longitude": {
          "type": "string"
        }
      },
      "required": [
        "geometry",
        "site-address"
      ]
    },
    "waste-management": {
      "type": "object",
      "properties": {
        "waste-management-facility-type": {
          "type": "string",
          "enum": [
            "inert-landfill",
            "non-hazardous-landfill",
            "hazardous-landfill",
            "energy-waste-incineration",
            "other-incineration",
            "landfill-gas-plant",
            "pyrolysis-gasification",
            "metal-recycling",
            "transfer-stations",
            "mrf",
            "household-amenity-site",
            "open-windrow-composting",
            "in-vessel-composting",
            "anaerobic-digestion",
            "mbt",
            "sewage-treatment",
            "other-treatment",
